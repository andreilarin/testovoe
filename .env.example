# Used by docker-compose (variable substitution) and by local runs (pydantic-settings reads .env).
API_KEY=dev-secret-key
LOG_LEVEL=INFO

# Local runs only; docker-compose sets these itself.
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Consumer tuning
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2.0
GATEWAY_MIN_DELAY=2.0
GATEWAY_MAX_DELAY=5.0
GATEWAY_SUCCESS_RATE=0.9
WEBHOOK_TIMEOUT=10.0

# Outbox relay tuning
OUTBOX_POLL_INTERVAL=1.0
OUTBOX_BATCH_SIZE=100

# Demo webhook receiver: share of requests answered with 503
WEBHOOK_RECEIVER_FAIL_RATE=0.3
